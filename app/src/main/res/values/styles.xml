<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Anland HUD design language: fixed lilac/charcoal palette, no dynamic colour. -->
    <style name="AppTheme.Base" parent="Theme.Material3.DayNight">
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="buttonStyle">@style/ButtonStyle</item>
        <item name="bg_config_card">@drawable/bg_config_card</item>
        <item name="textColorPrimary">?attr/colorOnSurface</item>
        <item name="textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="actionBarSize">56dp</item>

        <!-- colour roles -->
        <item name="colorPrimary">@color/a_primary</item>
        <item name="colorOnPrimary">@color/a_on_primary</item>
        <item name="colorPrimaryContainer">@color/a_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/a_on_primary_container</item>
        <item name="colorSecondary">@color/a_secondary</item>
        <item name="colorOnSecondary">@color/a_on_secondary</item>
        <item name="colorTertiary">@color/a_tertiary</item>
        <item name="colorOnTertiary">@color/a_on_tertiary</item>
        <item name="colorError">@color/a_error</item>
        <item name="colorOnError">@color/a_on_error</item>
        <item name="colorErrorContainer">@color/a_error_container</item>
        <item name="colorOnErrorContainer">@color/a_on_error_container</item>
        <item name="android:colorBackground">@color/a_background</item>
        <item name="colorOnBackground">@color/a_on_background</item>
        <item name="colorSurface">@color/a_surface</item>
        <item name="colorOnSurface">@color/a_on_surface</item>
        <item name="colorSurfaceVariant">@color/a_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/a_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/a_surface_low</item>
        <item name="colorSurfaceContainerLow">@color/a_surface_low</item>
        <item name="colorSurfaceContainer">@color/a_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/a_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/a_surface_highest</item>
        <item name="colorOutline">@color/a_outline</item>
        <item name="colorOutlineVariant">@color/a_outline_variant</item>
        <item name="colorControlHighlight">@color/a_primary_container</item>

        <!-- Anland shapes: hairline 1dp borders, 12dp controls, 16dp cards -->
        <item name="shapeAppearanceSmallComponent">@style/AnlandShape.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/AnlandShape.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/AnlandShape.Large</item>
        <item name="materialButtonStyle">@style/AnlandButton</item>

        <!-- System bars keep the platform colour: no app tint bleeding into them -->
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowBackground">@color/a_background</item>

        <!-- Anland top bar: 56dp, flat surface, real end inset so the overflow
             button never sits against the screen edge / rounded corner -->
        <item name="actionBarStyle">@style/AnlandActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.Anland.ActionBar</item>
        <item name="actionOverflowButtonStyle">@style/AnlandOverflowButton</item>
        <item name="actionButtonStyle">@style/AnlandActionButton</item>
        <item name="actionMenuTextColor">?attr/colorOnSurface</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.Anland.PopupMenu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Anland.Dialog.Alert</item>
    </style>

    <style name="AnlandActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:background">?attr/colorSurface</item>
        <item name="background">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="contentInsetStart">16dp</item>
        <item name="contentInsetEnd">12dp</item>
        <item name="contentInsetStartWithNavigation">16dp</item>
        <item name="contentInsetEndWithActions">12dp</item>
        <item name="titleTextStyle">@style/AnlandBarTitle</item>
        <item name="subtitleTextStyle">@style/AnlandBarSubtitle</item>
        <item name="maxButtonHeight">48dp</item>
    </style>

    <style name="AnlandBarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AnlandBarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="AnlandActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="AnlandOverflowButton" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.Anland.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.Anland.PopupMenu" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="popupMenuBackground">@drawable/bg_menu</item>
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="ThemeOverlay.Anland.Dialog.Alert" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/AnlandDialogShape</item>
        <item name="android:background">@drawable/bg_menu</item>
    </style>

    <style name="AnlandDialogShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="AnlandPopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="android:popupElevation">8dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="AnlandShape.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">8dp</item>
    </style>
    <style name="AnlandShape.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="AnlandShape.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="AnlandButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme.Base">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
        <item name="actionOverflowMenuStyle">@style/Widget.AppTheme.OverflowMenu</item>
        <item name="textAppearancePopupMenuHeader">@style/PopupMenuTextAppearanceHeader</item>
        <item name="textAppearanceSmallPopupMenu">@style/PopupMenuTextAppearanceSmall</item>
        <item name="textAppearanceLargePopupMenu">@style/PopupMenuTextAppearanceLarge</item>
    </style>

    <style name="Widget.AppTheme.OverflowMenu" parent="Widget.AppCompat.Light.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_menu</item>
        <item name="overlapAnchor">false</item>
    </style>

    <style name="PopupMenuTextAppearanceHeader" parent="TextAppearance.AppCompat.Widget.PopupMenu.Header">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceSmall" parent="TextAppearance.AppCompat.Widget.PopupMenu.Small">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="PopupMenuTextAppearanceLarge" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="FilePickerTheme" parent="Theme.Material3.DayNight.DialogWhenLarge">
        <item name="colorPrimary">@color/a_primary</item>
        <item name="colorOnPrimary">@color/a_on_primary</item>
        <item name="colorAccent">@color/a_primary</item>
        <item name="colorSurface">@color/a_surface_container</item>
        <item name="colorOnSurface">@color/a_on_surface</item>
        <item name="android:colorBackground">@color/a_background</item>
        <item name="android:windowBackground">@color/a_background</item>
        <item name="nnf_toolbarTheme">@style/ThemeOverlay.AppCompat.Dark.ActionBar</item>
        <item name="alertDialogTheme">@style/FilePickerAlertDialogTheme</item>
        <item name="nnf_separator_color">@color/nnf_separator_color</item>
        <item name="nnf_save_icon_color">?attr/colorAccent</item>
        <item name="nnf_dir_icon_color">?attr/colorAccent</item>

        <!-- These are important. Handled by toolbar. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="FilePickerAlertDialogTheme" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/file_picker_accent</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="ConfigTitleTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SwitchStyle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?textColorSecondary</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColorHint">#b0b0b0</item>
        <item name="android:textColor">?attr/textColorPrimary</item>
    </style>

    <style name="ButtonStyle" parent="Widget.AppCompat.Button.Colored">
        <item name="android:minHeight">38dp</item>
        <item name="android:paddingLeft">6dp</item>
        <item name="android:paddingRight">6dp</item>
        <item name="android:elevation" >1dp</item>
        <item name="android:background">@drawable/bg_button</item>
    </style>

    <style name="ImageButtonStyle" parent="Widget.AppCompat.ImageButton">
        <item name="android:minHeight">38dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:tint">?colorAccent</item>
    </style>

    <style name="TextViewVendor" parent="Widget.AppCompat.TextView" >
    </style>

</resources>
