<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:background="?android:colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.j2me.lixin.MainActivity">

    <!-- Anland top bar: flat surface, real end inset so the overflow button never
         touches the screen edge or the rounded corner of the display -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        app:contentInsetStartWithNavigation="0dp"
        app:contentInsetStart="4dp"
        app:contentInsetEnd="0dp"
        app:titleTextAppearance="@style/AnlandBarTitle"
        app:titleMarginStart="8dp" />

    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
